# Database
POSTGRES_USER=inventario
POSTGRES_PASSWORD=changeme
POSTGRES_DB=inventario
DATABASE_URL=postgresql://inventario:changeme@postgres:5432/inventario

# Redis (backend-api, bot-worker, openwa)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
REDIS_ENABLED=true
REDIS_BUILTIN=false
QUEUE_ENABLED=true

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# OpenWA — API_MASTER_KEY (contenedor openwa) DEBE ser IGUAL a OPENWA_API_KEY (backend/worker)
API_MASTER_KEY=owa_k1_xxxxxxxx
OPENWA_API_KEY=owa_k1_xxxxxxxx
OPENWA_BASE_URL=http://openwa:2785
OPENWA_WEBHOOK_URL=http://backend-api:3000/api/webhooks/openwa
OPENWA_WEBHOOK_SECRET=webhook-secret-change-me
# Panel OpenWA: prod https://HOST:2786 | local http://HOST:2785
OPENWA_PUBLIC_URL=https://localhost:2786
# Plugin zent-flow (OpenWA): mismo valor en config del plugin (zentApiSecret)
BOT_PLUGIN_SECRET=webhook-secret-change-me
ZENT_FLOW_PLUGIN_ENABLED=false
# Con IA activa, el backend pone zent-flow en passThrough=true via /settings/bot-ai/sync-openwa
# Nombre de la tienda en el bot de WhatsApp
STORE_NAME=Zent

# Novita AI — asistente conversacional del bot WhatsApp
NOVITA_API_KEY=
NOVITA_BASE_URL=https://api.novita.ai/openai
NOVITA_MODEL=deepseek/deepseek-v3.2
NOVITA_BOT_ENABLED=false
NOVITA_MIN_BALANCE_USD=0.01

# Reserva de stock en carritos WhatsApp (minutos)
CART_HOLD_TTL_MINUTES=30
# WhatsApp al cliente N minutos antes de que expire la reserva del carrito
CART_HOLD_WARN_MINUTES=5
# Follow-up WhatsApp tras carrito abandonado (horas) y ventana de recuperación (días)
ABANDONED_CART_FOLLOWUP_HOURS=2
ABANDONED_CART_RECOVERY_DAYS=7

# Teléfonos del vendedor para alertas de pedidos nuevos (separados por coma)
VENDOR_NOTIFY_PHONES=51987752653

# Host público del servidor (IP o dominio; usado por Traefik y URLs del frontend)
PUBLIC_HOST=localhost

# URL pública de la API (dashboard / webhooks externos)
PUBLIC_API_URL=http://localhost:3001/api

# Admin — con true, CADA arranque del API reabre /setup (solo para recuperacion puntual)
ADMIN_FORCE_RESET=false
# Dokploy: pon true en UN deploy para volver a mostrar /setup (sin borrar volumenes)
SETUP_FORCE_RESET=false

# Grafana (monitoring, prod)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3002
NEXT_PUBLIC_PROMETHEUS_URL=http://localhost:9090

# Novita AI (saldo y alertas)
NOVITA_MIN_BALANCE_USD=0.01
NOVITA_LOW_BALANCE_ALERT_USD=3
NOVITA_LOW_BALANCE_ALERT_COOLDOWN_MINUTES=360
# Opcional: webhook externo para alerta de saldo bajo
NOVITA_LOW_BALANCE_WEBHOOK_URL=

# n8n workflows — embebido en Dokploy y eventos firmados desde backend
N8N_WORKFLOWS_ENABLED=true
N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook/zent
# Genera una vez (openssl rand -hex 24) y no cambies entre deploys
N8N_WEBHOOK_SECRET=genera-secreto-hmac-estable-aqui
N8N_SALES_MODE=sandbox
N8N_CHAT_MODE=disabled
N8N_CHAT_WEBHOOK_URL=http://n8n:5678/webhook/zent-chat
N8N_CHAT_SANDBOX_PHONES=
N8N_CHAT_TIMEOUT_MS=5000
N8N_PUBLIC_URL=http://localhost:5678
# Minimo 32 caracteres; si cambia entre deploys, n8n pierde credenciales guardadas
N8N_ENCRYPTION_KEY=genera-clave-encriptacion-estable-32chars
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=elige-password-fuerte-n8n-ui
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=America/Lima

# Variables comerciales extra para el prompt IA
BOT_AI_PAYMENT_METHODS=Transferencia, Yape/Plin o pago contra entrega
BOT_AI_ORDER_STATUSES=NUEVO: recibido; EN_GESTION: en revisión; CONFIRMADO: confirmado; EN_DELIVERY: en reparto; COMPLETADO: entregado; CANCELADO: cancelado.
BOT_AI_WORKFLOW_POLICIES=Si el cliente envía referencia de pago, registra la referencia y espera validación del vendedor o automatización.

# Opcional; si no se define, se usa la sesión activa automáticamente
# OPENWA_SESSION_ID=

# SSRF_ALLOWED_HOSTS=backend-api — fijado en docker-compose, no en .env
