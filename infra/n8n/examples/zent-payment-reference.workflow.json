{
  "name": "Zent Payment Reference Review",
  "nodes": [
    {
      "parameters": {
        "path": "zent/payment.reference_submitted",
        "httpMethod": "POST",
        "responseMode": "responseNode"
      },
      "id": "webhook",
      "name": "Payment Reference Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, workflow: 'zent-payment-reference', orderId: $json.payload?.orderId, message: 'Referencia recibida para validacion' } }}"
      },
      "id": "respond",
      "name": "Respond Pending Validation",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [280, 0]
    }
  ],
  "connections": {
    "Payment Reference Webhook": {
      "main": [
        [
          {
            "node": "Respond Pending Validation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
