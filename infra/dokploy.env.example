# Copia estas variables en Dokploy → Environment (no commitees secretos reales al repo).
# Sustituye changeme, tu-ip-o-dominio y los secretos n8n por valores propios.

POSTGRES_USER=inventario
POSTGRES_PASSWORD=changeme
POSTGRES_DB=inventario
# Si el password tiene @, codificalo como %40 en DATABASE_URL
DATABASE_URL=postgresql://inventario:changeme@postgres:5432/inventario

JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
# PRODUCCION: debe ser false. Con true, CADA redeploy reabre /setup (ver DEPLOY.md).
ADMIN_FORCE_RESET=false
# Solo true en UN redeploy para reabrir /setup sin borrar volumenes; luego vuelve a false.
SETUP_FORCE_RESET=false

# OpenWA: API_MASTER_KEY (contenedor openwa) = OPENWA_API_KEY (backend-api / bot-worker)
API_MASTER_KEY=owa_k1_reemplaza-con-clave-generada
OPENWA_API_KEY=owa_k1_reemplaza-con-clave-generada
OPENWA_WEBHOOK_SECRET=webhook-secret-change-me
BOT_PLUGIN_SECRET=webhook-secret-change-me
ZENT_FLOW_PLUGIN_ENABLED=true
# true = backend instala/sincroniza zent-flow en OpenWA al completar /setup y al vincular WhatsApp

STORE_NAME=ZENT

CART_HOLD_TTL_MINUTES=30
CART_HOLD_WARN_MINUTES=5
VENDOR_NOTIFY_PHONES=
OPENWA_PUBLIC_URL=https://tu-ip-o-dominio:2786

# IP o dominio publico del VPS (Traefik, Grafana, Prometheus en el dashboard)
PUBLIC_HOST=tu-ip-o-dominio
PUBLIC_API_URL=http://tu-ip-o-dominio:3001/api
NEXT_PUBLIC_GRAFANA_URL=http://tu-ip-o-dominio:3002
NEXT_PUBLIC_PROMETHEUS_URL=http://tu-ip-o-dominio:9090

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# n8n embebido
N8N_WORKFLOWS_ENABLED=true
N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook/zent
# Genera una vez (openssl rand -hex 24) y no cambies entre deploys. Mismo valor en ZENT_N8N_SECRET de n8n.
N8N_WEBHOOK_SECRET=genera-secreto-hmac-estable-aqui
N8N_SALES_MODE=sandbox
N8N_CHAT_MODE=disabled
N8N_CHAT_WEBHOOK_URL=http://n8n:5678/webhook/zent-chat
N8N_CHAT_SANDBOX_PHONES=
N8N_CHAT_TIMEOUT_MS=5000
N8N_PUBLIC_URL=http://tu-ip-o-dominio:5678
# Minimo 32 caracteres; si cambia entre deploys, n8n pierde credenciales guardadas.
N8N_ENCRYPTION_KEY=genera-clave-encriptacion-estable-32chars
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=elige-password-fuerte-n8n-ui
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=America/Lima
